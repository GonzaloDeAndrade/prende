# Copiá este archivo a ".env" y completá tu API key.
OPENAI_API_KEY=

# Modelo para el análisis de clips. gpt-4o-mini = barato, gpt-4o = mejor criterio.
OPENAI_MODEL=gpt-4o-mini

# Transcripción local (faster-whisper). "auto" prueba GPU y cae a CPU si no hay.
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=es

# Reglas de selección de clips
MIN_CLIP_SECONDS=10
MAX_CLIP_SECONDS=30
MIN_CLIPS=5
MAX_CLIPS=10

# Formato de salida
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
SUBTITLE_FONT=Arial
SUBTITLE_FONT_SIZE=64
WORDS_PER_CAPTION=4
